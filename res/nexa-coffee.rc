#include <windows.h>
#include "resource.h"

IDI_APP ICON "nexa-coffee.ico"

// ── 버전 리소스 ──────────────────────────────────────────────────────────────
// 버전 정보가 통째로 빠진 작고 서명 없는 PE는 백신 ML 휴리스틱의 고전적 오탐 대상이다.
// 09-17 실측: Defender가 x86 zip을 Trojan:Win32/Tecabans.STV!cl(클라우드 ML)로 격리 →
// winget 검증이 설치 단계에서 실패(PR #433980). 서명이 없는 v1에서 할 수 있는 완화책.
// 숫자는 VERSION 파일에서 온다(Makefile · build.bat가 -D로 넘긴다) — 손으로 적지 않는다.
#ifndef CF_VER_MAJOR
#define CF_VER_MAJOR 0
#define CF_VER_MINOR 0
#define CF_VER_PATCH 0
#endif
#ifndef CF_ARCH64
#define CF_ARCH64 1
#endif

#define CF_STR2(x) #x
#define CF_STR(x) CF_STR2(x)
#define CF_VER_STR CF_STR(CF_VER_MAJOR) "." CF_STR(CF_VER_MINOR) "." CF_STR(CF_VER_PATCH)
#if CF_ARCH64
#define CF_ORIGNAME "nexa-coffee-x64.exe"
#else
#define CF_ORIGNAME "nexa-coffee-x86.exe"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION    CF_VER_MAJOR,CF_VER_MINOR,CF_VER_PATCH,0
PRODUCTVERSION CF_VER_MAJOR,CF_VER_MINOR,CF_VER_PATCH,0
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"   // en-US · Unicode
        BEGIN
            VALUE "CompanyName",      "SosomLab"
            VALUE "FileDescription",  "Nexa Coffee - tray timer that keeps the PC awake"
            VALUE "FileVersion",      CF_VER_STR
            VALUE "InternalName",     "nexa-coffee"
            VALUE "LegalCopyright",   "Copyright (c) 2026 SosomLab. MIT License."
            VALUE "OriginalFilename", CF_ORIGNAME
            VALUE "ProductName",      "Nexa Coffee"
            VALUE "ProductVersion",   CF_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// 입력 창: [ 0 ] day(s) [ 12 ] hour(s) [ 50 ] minute(s)   [Cancel] [Start]
// 글자는 실행 시 SetDlgItemTextW로 ko/en을 채운다(리소스는 영문 자리표시).
IDD_DHM DIALOGEX 0, 0, 236, 58
STYLE DS_MODALFRAME | DS_CENTER | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Custom duration"
FONT 9, "Segoe UI"
BEGIN
    EDITTEXT        IDC_D,   10, 10, 26, 13, ES_NUMBER | ES_RIGHT | ES_AUTOHSCROLL
    LTEXT           "day(s)",    IDC_LD,  39, 12, 34, 10
    EDITTEXT        IDC_H,   76, 10, 26, 13, ES_NUMBER | ES_RIGHT | ES_AUTOHSCROLL
    LTEXT           "hour(s)",   IDC_LH, 105, 12, 36, 10
    EDITTEXT        IDC_M,  144, 10, 26, 13, ES_NUMBER | ES_RIGHT | ES_AUTOHSCROLL
    LTEXT           "minute(s)", IDC_LM, 173, 12, 56, 10
    PUSHBUTTON      "Cancel", IDCANCEL, 124, 34, 50, 14
    DEFPUSHBUTTON   "Start",  IDOK,     178, 34, 50, 14
END
